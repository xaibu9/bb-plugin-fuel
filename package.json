{
  "name": "bb-plugin-fuel-bb",
  "version": "0.1.1",
  "type": "module",
  "engines": {
    "bb": ">=0.50",
    "bbPluginSdk": ">=0.6.157"
  },
  "bb": {
    "name": "Fuel BB",
    "description": "A strip in the sidebar footer with the usage limits of every provider bb reports (Claude Code, Kimi Code, Cursor, OpenCode and others), an optional Antigravity (Gemini) quota and the open thread's context fill with a compact button. Follows the active bb theme.",
    "branding": {
      "icon": "Gauge"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "0.6.157",
    "@radix-ui/react-slot": "^1.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@pierre/diffs": "~1.2.12",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "playwright-core": "^1.63.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.7.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2"
  },
  "description": "Sidebar strip with the usage limits of every provider bb reports, optional Antigravity (Gemini) quota, and the open thread's context fill.",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bb plugin build",
    "e2e": "node e2e/check.mjs"
  },
  "license": "MIT"
}
